<Window x:Class="UP._02._01.Windows.EditNewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP._02._01.Windows"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:EditNewOrderWindow}"
        Title="EditNewOrderWindow" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Артикул: " Grid.Row="0"/>
        <TextBox Text="Артикул: " Grid.Row="0" Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>
        
        <TextBlock Text="Cтатус заказа: " Grid.Row="1"/>
        <ComboBox Grid.Row="1"  Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>
        
        <TextBlock Text="Адрес пункта выдачи: " Grid.Row="2"/>
        <ComboBox Grid.Row="2"  Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>
        
        <TextBlock Text="Дата заказа: " Grid.Row="3"/>
        <DatePicker Grid.Row="3" x:Name="dateOrder"  Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>

        <TextBlock Text="Дата выдачи: " Grid.Row="4"/>
        <DatePicker Grid.Row="4" SelectedDate="{Binding Order.DateOrder}" x:Name="dateDelivery" DisplayDateStart="{Binding Order.DateOrder}" Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>

    </Grid>
</Window>
