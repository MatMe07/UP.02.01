<Page x:Class="UP._02._01.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UP._02._01.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance Type=local:OrderPage}"
      Title="OrderPage">

    <Grid>
        <Grid.RowDefinitions >
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Button Content="Назад" Padding="10 0" HorizontalAlignment="Left" x:Name="btnBack" Margin="0 5" Click="Button_Click"/>
            <Button Content="Создать заказ" Padding="10 0" HorizontalAlignment="Left"  Margin="0 5" Click="btnAddOrder_Click"/>
            
        </StackPanel>

        <ListBox ItemsSource="{Binding Orders}" Grid.Row="1" HorizontalContentAlignment="Stretch"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" MouseDoubleClick="ListBox_MouseDoubleClick" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="Black" Padding="10">
                        <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Articule}" Grid.Row="0"/>
                        <TextBlock Text="{Binding CodeOptaining}" Grid.Row="1"/>
                        <TextBlock Text="{Binding PickupPoint.Address}" Grid.Row="2"/>
                        <TextBlock Text="{Binding DateOrder, StringFormat='\{0:f}'}" Grid.Row="3"/>

                            <Border Grid.RowSpan="4" Grid.Column="1" BorderThickness="1" BorderBrush="Black" Padding="10">
                                
                                <TextBlock Text="{Binding DateDelivery, StringFormat='\{0:f}'}" VerticalAlignment="Center" />
                            </Border>


                    </Grid>
                        
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
