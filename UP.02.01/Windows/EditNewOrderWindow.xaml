<Window x:Class="UP._02._01.Windows.EditNewOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UP._02._01.Windows"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:EditNewOrderWindow}"
        Title="EditNewOrderWindow" MaxWidth="500" MinHeight="300" Height="300" Width="342">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Content="Назад" Padding="10 0" HorizontalAlignment="Left" Margin="0 10" Click="Button_Click"/>

        <Grid Grid.Row="1">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Артикул: " Grid.Row="0"/>
                <TextBox Text="{Binding Order.Articule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>

                <TextBlock Text="Cтатус заказа: " Grid.Row="1"/>
                <ComboBox Grid.Row="1" ItemsSource="{Binding  orderStatuses}"
                  SelectedValue="{Binding Order.OrderStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="StatusName"
                  Grid.Column="1"  Width="120" HorizontalAlignment="Left"/>

                <TextBlock Text="Адрес пункта выдачи: " Grid.Row="2"/>
                <ComboBox IsEditable="True" Grid.Row="2" ItemsSource="{Binding PickupPoints}"
                  SelectedValue="{Binding Order.PickupPoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="Address"
                  Grid.Column="1"  Width="120" HorizontalAlignment="Left"/>

                <TextBlock Text="Дата заказа: " Grid.Row="3"/>
                <DatePicker Grid.Row="3" SelectedDate="{Binding Order.DateOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="dateOrder"  Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>

                <TextBlock Text="Дата выдачи: " Grid.Row="4"/>
                <DatePicker Grid.Row="4" SelectedDate="{Binding Order.DateDelivery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="dateDelivery" DisplayDateStart="{Binding Order.DateOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Grid.Column="1" MinWidth="100" MaxWidth="180" HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1" Margin="10" Grid.ColumnSpan="2" HorizontalAlignment="Right">
                    <Button Content="Удалить" x:Name="btnDelete" Margin="0 0 10 0" Click="BtnDelete_Click" Background="{DynamicResource dopBack}"/>
                    <Button Content="Сохранить" Click="BtnSaveOrCreate_Click" Padding="10 0" Background="{DynamicResource accentVnim}"/>
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>

</Window>
